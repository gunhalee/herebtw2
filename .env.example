# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Browser/client key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key. Never expose this in client code.
SUPABASE_SECRET_KEY=

# Kakao Local REST API key. Use only on the server.
KAKAO_REST_API_KEY=

# HMAC secret for short-lived location resolution tokens.
LOCATION_RESOLUTION_TOKEN_SECRET=

# HMAC secret for the 180-day server-issued anonymous device cookie.
ABUSE_DEVICE_TOKEN_SECRET=

# Optional separate HMAC secret for rate-limit subject hashes.
# Falls back to ABUSE_DEVICE_TOKEN_SECRET when omitted.
ABUSE_SUBJECT_HASH_SECRET=

# Rotatable HMAC secret for Vercel-provided network addresses.
ABUSE_NETWORK_HASH_SECRET_CURRENT=

# BotID policy: enforce, shadow, or off. Defaults to enforce on Vercel.
BOTID_ENFORCEMENT_MODE=enforce

# Content moderation policy and decision-key HMAC. Server only.
MODERATION_RULES_VERSION=ko-safety-2026-08-v1
MODERATION_DECISION_KEY_SECRET=
MODERATION_EVIDENCE_KEY_CURRENT_VERSION=v1
MODERATION_EVIDENCE_KEY_CURRENT=
MODERATION_EVIDENCE_KEY_PREVIOUS_VERSION=
MODERATION_EVIDENCE_KEY_PREVIOUS=

# Single-operator moderation console. 64 lowercase hex; keep separate from evidence keys.
MODERATION_OPS_SECRET=
MODERATION_OPS_SESSION_TTL_SECONDS=43200
MODERATION_OPS_BASE_URL=

# Protected Supabase Cron -> Vercel worker request.
CRON_SECRET=

# Google Cloud Natural Language through Vercel OIDC -> GCP Workload Identity.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
MODERATION_GOOGLE_MODE=shadow
MODERATION_GOOGLE_SAMPLE_RATE=0.01
MODERATION_GOOGLE_TIMEOUT_MS=5000
MODERATION_GOOGLE_WARNING_USD=50
MODERATION_GOOGLE_MONTHLY_BUDGET_USD=100

# Telegram monitor channel. Alerts and commands are read-only.
TELEGRAM_MODERATION_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_MONITOR_CHANNEL_ID=
TELEGRAM_OPERATOR_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=

# Public data.go.kr API key. Use only on the server.
DATA_GO_KR_SERVICE_KEY=
# DATA_GO_KR_SERVICE_KEY_IS_ENCODED=1
# DATA_GO_KR_SERVICE_KEY_PARAM=ServiceKey
# DATA_GO_KR_SERVICE_KEY_FIRST=1
# DATA_GO_KR_HTTP_REFERER=https://www.data.go.kr/
